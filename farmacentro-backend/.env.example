# FarmaCentro API configuration. Copy to server/.env (excluded by .gitignore) and fill in.
# Generate the secrets with: npm run generate-keys

NODE_ENV=development
PORT=3000
# Exact origin of the web client (CORS, origin check, WebAuthn)
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally)
TRUST_PROXY=0

# Local MongoDB (same server as MongoDB Compass). It must run as replica set rs0 for transactions:
# see docs/manual-instalacion.md and npm run init-replica-set
MONGODB_URI=mongodb://localhost:27017/farmacentro
# Atlas: API database user with the custom role "farmacentroApi" (docs/modelo-datos.md §6)
# MONGODB_URI=mongodb+srv://farmacentro_api:<password>@<cluster>.mongodb.net/farmacentro

# Sessions (inactivity timeout is at most 15 minutes)
SESSION_SECRET=
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8

# Encryption keys: 32 bytes in base64 each
DATA_ENC_ACTIVE_VERSION=1
DATA_ENC_KEY_V1=
BLIND_INDEX_KEY=
OTP_HMAC_KEY=

# Password hashing (minimum 12)
BCRYPT_COST=12

# WebAuthn (fingerprint). RP_ID must be the domain of CLIENT_ORIGIN.
RP_ID=localhost
RP_NAME=FarmaCentro

# E-mail. console = development only: codes are printed in the backend terminal.
# smtp = real server (required outside development).
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FarmaCentro <no-reply@farmacentro.local>

# Allow the e-mailed code for re-authentication of sensitive operations (decision D-03)
STEP_UP_ALLOW_EMAIL=true

# Serve the built frontend (../Farmacentro-Frontend/dist) from the API: single origin for delivery/deployment
SERVE_CLIENT=false

LOG_LEVEL=info
