# Production configuration used ONLY from your computer to prepare Atlas
# (npm run setup-db:prod, seed:prod, check-db-privileges:prod, verify-audit:prod).
# Copy to .env.production (excluded by .gitignore). The keys MUST be the same values you
# enter in Render; otherwise the API cannot decrypt the data seeded from here.

NODE_ENV=production
CLIENT_ORIGIN=https://<tu-sitio>.netlify.app
RP_ID=<tu-sitio>.netlify.app
RP_NAME=FarmaCentro

# Atlas users (docs/manual-instalacion.md §4)
MONGODB_URI=mongodb+srv://farmacentro_api:<password>@<cluster>.mongodb.net/farmacentro
MONGODB_URI_API=mongodb+srv://farmacentro_api:<password>@<cluster>.mongodb.net/farmacentro
MONGODB_URI_ADMIN=mongodb+srv://farmacentro_migrator:<password>@<cluster>.mongodb.net/farmacentro
MONGODB_URI_AUDIT_READER=mongodb+srv://farmacentro_audit_reader:<password>@<cluster>.mongodb.net/farmacentro

# Same values as in Render (npm run generate-keys)
SESSION_SECRET=
DATA_ENC_ACTIVE_VERSION=1
DATA_ENC_KEY_V1=
BLIND_INDEX_KEY=
OTP_HMAC_KEY=

# E-mail through Brevo (the verified sender goes in MAIL_FROM)
MAIL_TRANSPORT=brevo
BREVO_API_KEY=
MAIL_FROM=FarmaCentro <correo-verificado-en-brevo@gmail.com>

# Demo users for the auditor group: private password and a real team mailbox.
# Each user receives codes at a sub-address: equipo+regente@gmail.com, equipo+cajero@gmail.com...
SEED_PASSWORD=
SEED_EMAIL=

# Atlas Administration API (only for npm run atlas:provision): service account of the project
# with the "Project Owner" role. Access Manager → Service Accounts. Not needed by Render.
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=farmacentro
