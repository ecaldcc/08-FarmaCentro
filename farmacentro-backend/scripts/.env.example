# Connection strings used ONLY by the scripts in /scripts (never by the API).
# Copy to scripts/.env and fill in. scripts/.env is excluded by .gitignore.

# Privileged user (readWrite + dbAdmin on farmacentro): setup-db, seed, backup.
# Optional in local development: if empty, MONGODB_URI from .env is used.
MONGODB_URI_ADMIN=

# API user (custom role farmacentroApi): check-db-privileges
# MONGODB_URI_API=mongodb+srv://farmacentro_api:<password>@<cluster>.mongodb.net/farmacentro

# Read-only audit user (custom role auditReader): verify-audit
# MONGODB_URI_AUDIT_READER=mongodb+srv://farmacentro_audit_reader:<password>@<cluster>.mongodb.net/farmacentro

# Backup encryption key: 32 bytes in base64 (npm run generate-keys)
BACKUP_ENC_KEY=

# Seed password. Optional in development (a public demo password is used);
# REQUIRED when NODE_ENV=production.
SEED_PASSWORD=
