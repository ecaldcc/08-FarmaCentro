{
  "name": "farmacentro",
  "version": "0.1.0",
  "private": true,
  "description": "FarmaCentro management system (academic prototype, Seguridad y Auditoría de Sistemas, UMG)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:db": "tsx scripts/dev-memory-db.ts",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "audit:check": "tsx scripts/audit-report.ts",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "setup-db": "tsx scripts/setup-db.ts",
    "seed": "tsx scripts/seed.ts",
    "verify-audit": "tsx scripts/verify-audit-chain.ts",
    "check-db-privileges": "tsx scripts/check-db-privileges.ts",
    "backup": "tsx scripts/backup.ts",
    "restore-test": "tsx scripts/restore-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.70.1"
  }
}
